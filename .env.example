# Copy the VITE_ variables to frontend/.env.local for the frontend.
VITE_API_URL=http://localhost:8000

# Local backend configuration. Never expose these with a VITE_ prefix.
MEDIQUEUE_DB_PATH=mediqueue.db
MEDIQUEUE_ADMIN_EMAIL=admin@example.com
MEDIQUEUE_ADMIN_PASSWORD=choose-a-strong-private-password
MEDIQUEUE_ADMIN_NAME=MediQueue Admin
